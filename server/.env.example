# Anthropic Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Supabase (Postgres) — service key, server-side only. Never expose to the client.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# CORS — the exact origin of the deployed frontend (no trailing slash).
# Comma-separate to allow more than one (e.g. local dev + prod).
FRONTEND_URL=http://localhost:5173

# Server
PORT=5000
# LOG_LEVEL=info
